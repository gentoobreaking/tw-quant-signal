# tw-quant-signal 環境變數範例
# 複製為 .env 並修改後使用：docker-compose --env-file .env up

# 資料提供者模式：direct | mcp | hybrid (預設 direct)
TW_QUANT_DATA_PROVIDER=direct

# MCP 模式必填：tw-quant-mcp 執行檔路徑（容器內路徑）
# 若用 sidecar 模式，請確保 tw-quant-mcp 以相同路徑掛載於 app/scheduler 容器
MCP_SERVER_PATH=/app/tw-quant-mcp

# MCP 單次 tool 呼叫逾時（秒，預設 30）
MCP_CALL_TIMEOUT=30

# Telegram 通知（任選一）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord 通知
DISCORD_WEBHOOK_URL=

# 資料庫路徑（容器內固定 /app/data/signal.db，通常不需改）
# TW_QUANT_DB=/app/data/signal.db