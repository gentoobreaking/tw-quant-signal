# tw-quant-signal 環境變數範例
# 複製為 .env 並修改：cp .env.example .env
# docker-compose 會自動讀取 .env（不需 --env-file）

# 資料提供者模式：direct | mcp | hybrid (預設 direct)
# 使用 mcp/hybrid 時，Dockerfile 會自動編譯 tw-quant-mcp（submodule）到 /app/tw-quant-mcp
#TW_QUANT_DATA_PROVIDER=direct
TW_QUANT_DATA_PROVIDER=mcp

# MCP 執行檔路徑（容器內固定，Dockerfile 已編譯好）
MCP_SERVER_PATH=/app/tw-quant-mcp

# MCP 單次 tool 呼叫逾時（秒，預設 30）
MCP_CALL_TIMEOUT=30

# Telegram 通知（任選一）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord 通知
DISCORD_WEBHOOK_URL=

# 資料庫路徑（容器內固定 /app/data/signal.db，通常不需改）
# TW_QUANT_DB=/app/data/signal.db
